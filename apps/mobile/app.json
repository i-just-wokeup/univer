{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e7a0008e-b18f-4a2c-92ad-6f062fbbd450"
    },
    "scheme": "univer",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#FFFFFF",
          "barStyle": "dark",
          "position": "relative",
          "behavior": "inset-touch"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "스토리를 촬영하려면 카메라 접근 권한이 필요합니다.",
          "microphonePermission": "영상 촬영 시 마이크 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "사진을 게시물·스토리에 올리려면 사진 접근 권한이 필요합니다."
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#7C3AED"
        }
      ],
      "expo-video",
      "@sentry/react-native",
      "./plugins/withDisableAutofill"
    ],
    "ios": {
      "bundleIdentifier": "com.univer.app",
      "supportsTablet": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "android": {
      "edgeToEdgeEnabled": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.univer.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7a0008e-b18f-4a2c-92ad-6f062fbbd450"
      }
    }
  }
}
